# Copy to .env and fill in. Never commit .env -- it is gitignored.

# Brokers / data
ALPACA_API_KEY=
ALPACA_API_SECRET=
FRED_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_TOKEN=
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
BLS_API_KEY=

# Public hosting. Leave SITE_PASSWORD empty for local development -- the
# gate is then a transparent pass-through and localhost:8000 is unchanged.
# Set it before exposing the hub through Tailscale Funnel.
SITE_PASSWORD=
# Leave this UNSET. When unset, a random secret is generated fresh at every
# startup, which invalidates every existing session cookie on restart -- that
# is currently the ONLY way to revoke a stolen/leaked session cookie, since
# there is no server-side session store to revoke one from directly. Setting
# this value removes that safety net: sessions then survive restarts, and a
# stolen cookie stays valid until it naturally expires (see DEFAULT_TTL in
# site_gate.py, 24h).
SESSION_SECRET=
